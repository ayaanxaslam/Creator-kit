# Copy this file to .env.local and fill in your values.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: override the model (defaults to gpt-5.4-mini)
# OPENAI_MODEL=gpt-5.4-mini

# Supabase — Project Settings → API (or "Connect") in the Supabase dashboard.
# Only read on the server, so no NEXT_PUBLIC_ prefix is needed (it's accepted too).
SUPABASE_URL=
# The anon key or the newer publishable key
SUPABASE_ANON_KEY=

# Optional: your site's public URL, used in sign-up and password reset emails.
# Detected automatically from the request if not set.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
